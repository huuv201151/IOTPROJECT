# ==============================================================================
# RainSense — Smart Rainfall & Environmental Monitoring System
# Environment Configuration Template (EMQX MQTT & Aiven PostgreSQL Stack)
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Aiven PostgreSQL)
# ------------------------------------------------------------------------------
# Lấy Service URI từ Aiven Console (Dịch vụ Aiven for PostgreSQL)
# Cú pháp: postgresql://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?sslmode=require
# Lưu ý: Aiven bắt buộc có tham số '?sslmode=require'
DATABASE_URL="postgresql://avnadmin:YOUR_AIVEN_PASSWORD@pg-cluster-id.aivencloud.com:12345/defaultdb?sslmode=require"

# (Hoặc nếu dùng PostgreSQL cục bộ trong khi dev):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rainsense?sslmode=disable"

# ------------------------------------------------------------------------------
# 2. MQTT BROKER CONFIGURATION (EMQX)
# ------------------------------------------------------------------------------
# Tùy chọn 1: EMQX Public Test Broker (Không cần tài khoản, dùng thử ngay)
# MQTT_BROKER_URL="mqtt://broker.emqx.io:1883"
#
# Tùy chọn 2: EMQX Cloud (Bảo mật TLS Port 8883)
# MQTT_BROKER_URL="mqtts://your-instance.emqx.cloud:8883"
#
# Tùy chọn 3: EMQX Local Docker / Cục bộ (Port 1883 hoặc 8883)
# MQTT_BROKER_URL="mqtt://localhost:1883"

MQTT_BROKER_URL="mqtt://broker.emqx.io:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_CLIENT_ID="rainsense-backend-server"
MQTT_TOPIC_PREFIX="weather"

# TLS / SSL Settings cho EMQX:
# - Đặt 'true' nếu dùng chứng chỉ hợp lệ (EMQX Cloud chính thức)
# - Đặt 'false' nếu dùng chứng chỉ tự ký (self-signed) hoặc test nội bộ
MQTT_REJECT_UNAUTHORIZED="true"

# Đường dẫn file chứng chỉ CA nếu EMQX Cloud yêu cầu (tùy chọn):
MQTT_CA_CERT=""

# MQTT Keepalive (giây)
MQTT_KEEPALIVE=60

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET="rainsense_super_secure_jwt_secret_key_at_least_32_characters"
ADMIN_EMAIL="admin@rainsense.io"
ADMIN_PASSWORD="Admin@ChangeMe123!"

# ------------------------------------------------------------------------------
# 4. APPLICATION OPERATION MODES
# ------------------------------------------------------------------------------
# Set to 'false' để nhận dữ liệu thật từ EMQX MQTT và lưu trực tiếp vào Aiven PostgreSQL
# Set to 'true' để bật bộ giả lập tự động phát dữ liệu mưa (dành cho demo giao diện)
DEMO_MODE=false

# CORS Allowlist (phân cách bằng dấu phẩy)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Station Default Settings
DEFAULT_STATION_ID="RS-ESP32S3-01"
DEFAULT_CALIBRATION_MM_PER_TIP=0.25
DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (apps/web/.env.local)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL="http://localhost:5000"
# NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
# NEXT_PUBLIC_DEFAULT_DEVICE_ID="RS-ESP32S3-01"

# 6. Google Gemini AI Studio Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
